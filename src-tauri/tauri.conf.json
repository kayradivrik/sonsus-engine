{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KRNL Launcher",
  "version": "0.1.0",
  "identifier": "dev.krnl.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "overdrive // library",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["/**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
